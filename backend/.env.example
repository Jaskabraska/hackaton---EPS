# Copy this file to .env and paste the shared key (shared privately, never via the repo).
# Gemini via its OpenAI-compatible endpoint (free tier).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3-flash
LLM_API_KEY=

# --- Fallbacks (same OpenAI-compatible interface, only these vars change) ---
# Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1            LLM_MODEL=llama-3.3-70b-versatile
# Ollama: LLM_BASE_URL=http://localhost:11434/v1                 LLM_MODEL=llama3.1   LLM_API_KEY=ollama
#
# For the final demo only you may set LLM_MODEL=gemini-2.5-pro (strict 50 requests/day free limit).
