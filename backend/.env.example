# Copy this file to .env and paste your provider key (shared privately, never via the repo).
# Groq via its OpenAI-compatible endpoint.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# Alternatives using the same OpenAI-compatible interface:
# Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   LLM_MODEL=gemini-2.5-flash
# Ollama: LLM_BASE_URL=http://localhost:11434/v1                                  LLM_MODEL=llama3.1   LLM_API_KEY=ollama
